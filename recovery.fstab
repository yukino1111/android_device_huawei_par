# par (nova 3) 为拆分式启动布局，无独立 ramdisk/boot 分区（system-as-root），
# 故相对 charlotte 删除 /ramdisk 项。
/kernel            emmc      /dev/block/bootdevice/by-name/kernel            flags=display="Kernel";backup=1
/recovery_ramdisk  emmc      /dev/block/bootdevice/by-name/recovery_ramdisk  flags=display="Recovery Ramdisk";backup=1
/cache             ext4      /dev/block/bootdevice/by-name/cache
/misc              emmc      /dev/block/bootdevice/by-name/misc              flags=display="Misc";backup=0
/data              f2fs      /dev/block/bootdevice/by-name/userdata
/system            ext4      /dev/block/bootdevice/by-name/system
/system_image      emmc      /dev/block/bootdevice/by-name/system
/vendor            ext4      /dev/block/bootdevice/by-name/vendor
/vendor_image      emmc      /dev/block/bootdevice/by-name/vendor

# Safety boundary: cust, oeminfo, 3rdmodem, modemnvm*, persist and other
# device-identity/baseband partitions are intentionally hidden from TWRP.

# PAR OTG block uevents use this DWC3 sysfs prefix. Keep the vold-style auto
# entry so TWRP handles both whole-disk filesystems and partitioned USB media.
/devices/platform/ff200000.hisi_usb/ff100000.dwc3/*  auto  auto  defaults  voldmanaged=usbotg:auto
