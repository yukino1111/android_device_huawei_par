+#include "Keystore2Keymaster3.h"
+
+#include "Keymaster3.h"
+
+#include <sqlite3.h>
+
+#include <stdio.h>
+
+#include <keystore/authorization_set.h>
+
+bool Decrypt_Keystore2_Key_Blob(const std::string& handle,
+                                const uint8_t* iv, size_t iv_size,
+                                const uint8_t* input, size_t input_size,
+                                const std::vector<uint8_t>& auth_token,
+                                std::string* output) {
+    const std::string alias = "synthetic_password_" + handle;
+    std::string key_blob;
+    sqlite3* db = nullptr;
+    sqlite3_stmt* stmt = nullptr;
+    const char* query =
+        "SELECT b.blob FROM blobentry b JOIN keyentry k ON k.id=b.keyentryid "
+        "WHERE k.alias=? AND b.subcomponent_type=0 AND k.state=1 "
+        "ORDER BY b.id DESC LIMIT 1";
+
+    if (sqlite3_open_v2("/data/misc/keystore/persistent.sqlite", &db,
+            SQLITE_OPEN_READONLY, nullptr) != SQLITE_OK ||
+            sqlite3_prepare_v2(db, query, -1, &stmt, nullptr) != SQLITE_OK ||
+            sqlite3_bind_text(stmt, 1, alias.c_str(), -1, SQLITE_TRANSIENT) != SQLITE_OK ||
+            sqlite3_step(stmt) != SQLITE_ROW) {
+        printf("Failed to load Keystore2 alias '%s': %s\n", alias.c_str(),
+               db ? sqlite3_errmsg(db) : "database open failed");
+        if (stmt) sqlite3_finalize(stmt);
+        if (db) sqlite3_close(db);
+        return false;
+    }
+    const void* blob = sqlite3_column_blob(stmt, 0);
+    const int blob_size = sqlite3_column_bytes(stmt, 0);
+    if (blob && blob_size > 0)
+        key_blob.assign(static_cast<const char*>(blob), blob_size);
+    sqlite3_finalize(stmt);
+    sqlite3_close(db);
+    if (key_blob.empty()) {
+        printf("Keystore2 alias '%s' has no key blob\n", alias.c_str());
+        return false;
+    }
+
+    ::keystore::AuthorizationSetBuilder begin_params;
+    begin_params.Authorization(::keystore::TAG_ALGORITHM, ::keystore::Algorithm::AES);
+    begin_params.Authorization(::keystore::TAG_BLOCK_MODE, ::keystore::BlockMode::GCM);
+    begin_params.Padding(::keystore::PaddingMode::NONE);
+    begin_params.Authorization(::keystore::TAG_NONCE, iv, iv_size);
+    begin_params.Authorization(::keystore::TAG_MAC_LENGTH, 128U);
+    if (!auth_token.empty())
+        begin_params.Authorization(::keystore::TAG_AUTH_TOKEN,
+                                   auth_token.data(), auth_token.size());
+
+    android::vold::Keymaster keymaster;
+    if (!keymaster) {
+        printf("Failed to get Keymaster 3 service for Keystore2 blob\n");
+        return false;
+    }
+    auto operation = keymaster.begin(::keystore::KeyPurpose::DECRYPT, key_blob,
+                                     begin_params, nullptr);
+    if (!operation) {
+        printf("Keymaster failed to begin Keystore2 synthetic-password decrypt: %d\n",
+               static_cast<int32_t>(operation.errorCode()));
+        return false;
+    }
+    if (!operation.updateCompletely(
+            std::string(reinterpret_cast<const char*>(input), input_size), output)) {
+        printf("Keymaster failed to update Keystore2 synthetic-password decrypt\n");
+        return false;
+    }
+    std::string finish_output;
+    if (!operation.finish(&finish_output)) {
+        printf("Keymaster failed to finish Keystore2 synthetic-password decrypt\n");
+        return false;
+    }
+    output->append(finish_output);
+    return true;
+}
