+static bool read_le32_at(int fd, off_t offset, uint32_t& value) {
+	unsigned char bytes[4];
+	if (pread(fd, bytes, sizeof(bytes), offset) != sizeof(bytes))
+		return false;
+	value = static_cast<uint32_t>(bytes[0]) |
+		(static_cast<uint32_t>(bytes[1]) << 8) |
+		(static_cast<uint32_t>(bytes[2]) << 16) |
+		(static_cast<uint32_t>(bytes[3]) << 24);
+	return true;
+}
+
+static bool read_le64_at(int fd, off_t offset, uint64_t& value) {
+	unsigned char bytes[8];
+	if (pread(fd, bytes, sizeof(bytes), offset) != sizeof(bytes))
+		return false;
+	value = 0;
+	for (size_t i = 0; i < sizeof(bytes); ++i)
+		value |= static_cast<uint64_t>(bytes[i]) << (i * 8);
+	return true;
+}
+
+static bool f2fs_active_checkpoint_has_nat_bits(const string& block_device) {
+	static const off_t super_offset = 1024;
+	static const off_t checkpoint_flags_offset = 132;
+	static const uint32_t f2fs_magic = 0xF2F52010;
+	static const uint32_t cp_nat_bits_flag = 0x80;
+	int fd = open(block_device.c_str(), O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+
+	uint32_t magic, log_blocksize, log_blocks_per_segment, checkpoint_block;
+	bool valid = read_le32_at(fd, super_offset, magic) &&
+		read_le32_at(fd, super_offset + 16, log_blocksize) &&
+		read_le32_at(fd, super_offset + 20, log_blocks_per_segment) &&
+		read_le32_at(fd, super_offset + 76, checkpoint_block) &&
+		magic == f2fs_magic && log_blocksize == 12 &&
+		log_blocks_per_segment < 31 && checkpoint_block != 0;
+	if (!valid) {
+		close(fd);
+		return false;
+	}
+
+	off_t checkpoint_one = static_cast<off_t>(checkpoint_block) << log_blocksize;
+	uint64_t checkpoint_two_block = static_cast<uint64_t>(checkpoint_block) +
+		(1ULL << log_blocks_per_segment);
+	off_t checkpoint_two = static_cast<off_t>(checkpoint_two_block << log_blocksize);
+	uint64_t version_one, version_two;
+	uint32_t flags_one, flags_two;
+	valid = read_le64_at(fd, checkpoint_one, version_one) &&
+		read_le32_at(fd, checkpoint_one + checkpoint_flags_offset, flags_one) &&
+		read_le64_at(fd, checkpoint_two, version_two) &&
+		read_le32_at(fd, checkpoint_two + checkpoint_flags_offset, flags_two);
+	close(fd);
+	if (!valid)
+		return false;
+
+	uint32_t active_flags = version_two > version_one ? flags_two : flags_one;
+	LOGINFO("F2FS checkpoint probe: versions %llu/%llu, active flags 0x%08x.\n",
+		static_cast<unsigned long long>(version_one),
+		static_cast<unsigned long long>(version_two), active_flags);
+	return (active_flags & cp_nat_bits_flag) != 0;
+}
+#endif
