+std::string unwrapSyntheticPasswordBlobKeystore2(const std::string& spblob_path,
+		const std::string& handle_str, const void* application_id,
+		const size_t application_id_size, const std::vector<uint8_t>& auth_token) {
+#ifdef USE_KEYSTORAGE_3
+	std::string disk_decryption_secret_key;
+	std::string spblob_data;
+	if (!android::base::ReadFileToString(spblob_path + handle_str + ".spblob", &spblob_data) ||
+			spblob_data.size() < 2 + 12 + 16) {
+		printf("Failed to read a valid Keystore2 synthetic-password blob\n");
+		return disk_decryption_secret_key;
+	}
+	const uint8_t version = static_cast<uint8_t>(spblob_data[0]);
+	if ((version != SYNTHETIC_PASSWORD_VERSION_V2 &&
+			version != SYNTHETIC_PASSWORD_VERSION_V3) ||
+			static_cast<uint8_t>(spblob_data[1]) != SYNTHETIC_PASSWORD_PASSWORD_BASED) {
+		printf("Unsupported Keystore2 synthetic-password blob version/type %u/%u\n",
+			version, static_cast<uint8_t>(spblob_data[1]));
+		return disk_decryption_secret_key;
+	}
+
+	const uint8_t* iv = reinterpret_cast<const uint8_t*>(spblob_data.data() + 2);
+	const char* cipher_text = spblob_data.data() + 2 + 12;
+	const size_t cipher_text_size = spblob_data.size() - 2 - 12;
+	std::string intermediate_key;
+	if (!Decrypt_Keystore2_Key_Blob(handle_str, iv, 12,
+			reinterpret_cast<const uint8_t*>(cipher_text), cipher_text_size,
+			auth_token, &intermediate_key)) {
+		return disk_decryption_secret_key;
+	}
+	if (intermediate_key.size() < 12 + 16) {
+		printf("Keymaster returned a short synthetic-password payload (%zu)\n",
+			intermediate_key.size());
+		return disk_decryption_secret_key;
+	}
+
+	void* personalized_application_id = PersonalizedHashBinary(
+		PERSONALISATION_APPLICATION_ID, static_cast<const char*>(application_id),
+		application_id_size);
+	if (!personalized_application_id)
+		return disk_decryption_secret_key;
+	const uint8_t* intermediate_iv =
+		reinterpret_cast<const uint8_t*>(intermediate_key.data());
+	const uint8_t* encrypted_secret = intermediate_iv + 12;
+	const size_t encrypted_secret_size = intermediate_key.size() - 12 - 16;
+	const uint8_t* tag = encrypted_secret + encrypted_secret_size;
+	std::vector<uint8_t> secret_key(encrypted_secret_size);
+	EVP_CIPHER_CTX* ctx = EVP_CIPHER_CTX_new();
+	int actual_size = 0;
+	int final_size = 0;
+	bool openssl_ok = ctx &&
+		EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), nullptr,
+			static_cast<const uint8_t*>(personalized_application_id), intermediate_iv) == 1 &&
+		EVP_DecryptUpdate(ctx, secret_key.data(), &actual_size, encrypted_secret,
+			encrypted_secret_size) == 1 &&
+		EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, 16,
+			const_cast<uint8_t*>(tag)) == 1 &&
+		EVP_DecryptFinal_ex(ctx, secret_key.data() + actual_size, &final_size) == 1;
+	if (ctx) EVP_CIPHER_CTX_free(ctx);
+	free(personalized_application_id);
+	if (!openssl_ok) {
+		printf("Failed to authenticate application-bound synthetic-password payload\n");
+		return disk_decryption_secret_key;
+	}
+	secret_key.resize(actual_size + final_size);
+	if (version == SYNTHETIC_PASSWORD_VERSION_V3) {
+		disk_decryption_secret_key = PersonalizedHashSP800(PERSONALIZATION_FBE_KEY,
+			PERSONALISATION_CONTEXT, reinterpret_cast<const char*>(secret_key.data()),
+			secret_key.size());
+	} else {
+		disk_decryption_secret_key = PersonalizedHash(PERSONALIZATION_FBE_KEY,
+			reinterpret_cast<const char*>(secret_key.data()), secret_key.size());
+	}
+	printf("Unwrapped synthetic password with Keystore2\n");
+	return disk_decryption_secret_key;
+#else
+	return "";
+#endif
+}
